# Models: Ollama runs natively on the host
OLLAMA_URL=http://host.docker.internal:11434
JUDGE_MODEL=clef-flash
CLOUD_MODEL=glm-5.3-flash:cloud
LOCAL_MODEL=llama3.2:3b

PHI_THRESHOLD=0.20
URGENT_THRESHOLD=0.25
RECHECK_THRESHOLD=0.50

# Database (decision log only, never message text)
POSTGRES_USER=gate
POSTGRES_PASSWORD=
POSTGRES_DB=gate
DATABASE_URL=postgresql://gate:gate_dev_password@db:5432/gate